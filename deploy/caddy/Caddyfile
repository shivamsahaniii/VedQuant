# VedQuant "share" site: the BUILT frontend (frontend/dist) + the API, on one port.
# Used for access from other devices (Tailscale: `tailscale serve --bg 8080`), which adds HTTPS.
# The developer site (http://local.vedquant.com, Apache -> Vite) is separate and unchanged.
{
	auto_https off
	admin off
}

:8080 {
	encode gzip

	# API and live-price WebSocket: "/api" is removed, as in the Apache site.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# The single-page app: unknown paths (e.g. /paper, /dhan/callback) load index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}
