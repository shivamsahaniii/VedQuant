# Vedquant environment. Copy to .env and fill in. Never commit .env.
# Broker API keys are NOT set here: each user adds their own from the dashboard.

APP_NAME=Vedquant
APP_ENV=dev

# paper (default) or live. Live also requires each user to switch their own account to live.
TRADING_MODE=paper

# Inside Docker use host "db" / "redis"; running the backend on your machine use "localhost".
DATABASE_URL=postgresql+asyncpg://vedquant:vedquant@localhost:5432/vedquant
REDIS_URL=redis://localhost:6380/0

# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

MARKET_TZ=Asia/Kolkata

# Optional (Phase 3)
TELEGRAM_BOT_TOKEN=
